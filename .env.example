# --- captions (optional but recommended) ---
# Get a key at https://aistudio.google.com — free tier is enough for 1 caption/day.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Instagram publishing (leave empty until Meta setup is done; see README) ---
IG_LOGIN_FLOW=instagram          # "instagram" (graph.instagram.com) or "facebook"
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0

# Public HTTPS base URL where out/post-*.jpg gets uploaded before publishing
# (GitHub release, Cloudflare R2 public bucket, ...). Empty = dry-run only.
MEDIA_PUBLIC_BASE=

# --- behaviour ---
DRY_RUN=1                        # SAFE DEFAULT. Set 0 (or use --live) to publish.
MAKE_REEL=0                      # 1 = also render the 9:16 reel
PRODUCT_COOLDOWN_DAYS=30
BRAND_NAME=Hellocomp.cz

# --- format ---
POST_FORMAT=carousel             # carousel (3 slides) | image (single card)
